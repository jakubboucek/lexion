#!/usr/bin/env bash
# Runs a command of the pdftools image over the repository. Paths are relative
# to the repository root, which is mounted as the working directory.
#
#   bin/pdf pdf-probe .data/rozvrh.pdf
#   bin/pdf pdf-text .data/rozvrh.pdf > .data/rozvrh.txt
#   bin/pdf pdf-tables .data/rozvrh.docx
#   bin/pdf pdf-pages --pages=1-3 --out=.data/pages .data/rozvrh.pdf
#
# Without arguments it lists what the image can do.
set -euo pipefail

cd "$(dirname "$0")/.."

exec docker compose --profile tools run --rm --no-deps -T pdftools "$@"
