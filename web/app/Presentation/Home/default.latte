    <a n:if="!$user->isLoggedIn()" href="{plink :Sign:in}" class="btn btn-primary">Přihlásit se</a>
    <a n:if="$user->isLoggedIn()" href="{plink :Panel:Dashboard:}" class="btn btn-primary">Můj přehled</a>
</div>
