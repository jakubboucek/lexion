<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ifset title}{include title|stripHtml} · {/ifset}Lexion</title>
    <link rel="icon" href="{$basePath}/favicon.svg" type="image/svg+xml">
    {asset? 'main.js'}
</head>

<body class="flex min-h-screen flex-col bg-base-200">
    {* One app, one navbar: the logo always leads home. The only exceptions:
       the homepage stays clean (no page navigation) and the sign-in page has
       no menu at all; everything else just distinguishes logged in/out. *}
    {var $isHome = $presenter->getName() === 'Home'}
    {var $isSign = $presenter->getName() === 'Sign'}

    <div class="navbar bg-base-100 shadow-sm">
        <div class="flex-1">
            <a href="{plink :Home:}" class="btn btn-ghost">{include logo-heavy from '@brand.latte'}</a>
        </div>
        <div n:if="!$isSign" class="flex-none">
            <ul class="menu menu-horizontal gap-1 px-1">
                <li n:if="!$isHome"><a href="{plink :Home:}">Hledat spis</a></li>
                <li><a href="{plink :Panel:Dashboard:}">Můj přehled</a></li>
                <li n:if="$user->isLoggedIn()">
                    <details>
                        <summary>{$user->getIdentity()->nick}</summary>
                        <ul class="right-0 z-1 w-44 rounded-t-none bg-base-100 p-2 shadow">
                            <li><a href="{plink :Sign:out}">Odhlásit</a></li>
                        </ul>
                    </details>
                </li>
            </ul>
        </div>
    </div>

    <main class="container mx-auto flex-1 p-4 sm:p-6">
        {ifset #breadcrumbs}
        <div class="breadcrumbs mb-4 text-sm text-base-content/70">
            <ul>{include #breadcrumbs}</ul>
        </div>
        {/ifset}

        <div n:foreach="$flashes as $flash" n:class="alert, 'mb-4', ($flash->type === 'error' ? 'alert-error' : 'alert-info')">
            {$flash->message}
        </div>

        {include content}
    </main>

    <footer class="p-4 text-center text-sm text-base-content/60">
        <p>{include wordmark-heavy from '@brand.latte', class: 'opacity-60'} je soukromý projekt, nejedná se o veřejnou službu. <a href="{plink :About:}" class="link">O projektu</a></p>
    </footer>
</body>
</html>
