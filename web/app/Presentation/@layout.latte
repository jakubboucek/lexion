<!DOCTYPE html>
<html lang="cs" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ifset title}{include title|stripHtml} · {/ifset}Lexion</title>
    {asset? 'main.js'}
</head>

<body class="min-h-screen bg-base-200">
    <div class="navbar bg-base-100 shadow-sm">
        <div class="flex-1">
            <a href="{plink :Home:}" class="btn btn-ghost text-lg">Lexion</a>
        </div>
        <div class="flex-none">
            <ul class="menu menu-horizontal gap-1 px-1">
                <li n:if="!$user->isLoggedIn()">
                    <a href="{plink :Sign:in}">Přihlásit se</a>
                </li>
                <li n:if="$user->isLoggedIn()">
                    <a href="{plink :Panel:Dashboard:}">Můj přehled</a>
                </li>
            </ul>
        </div>
    </div>

    <main class="container mx-auto p-4 sm:p-6">
        <div n:foreach="$flashes as $flash" n:class="alert, 'mb-4', ($flash->type === 'error' ? 'alert-error' : 'alert-info')">
            {$flash->message}
        </div>

        {include content}
    </main>
</body>
</html>
