{block title}Přihlášení{/block}

{block content}
<div class="mx-auto mt-8 w-full max-w-sm">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">Přihlášení</h1>

            <form n:name="signInForm" class="mt-2 flex flex-col gap-4">
                <div n:foreach="$form->getOwnErrors() as $error" class="alert alert-error text-sm">
                    {$error}
                </div>

                <label class="form-control w-full">
                    <span class="label-text mb-1 font-semibold">E-mail</span>
                    <input n:name="email" autofocus class="input input-bordered w-full">
                </label>

                <label class="form-control w-full">
                    <span class="label-text mb-1 font-semibold">Heslo</span>
                    <input n:name="password" class="input input-bordered w-full">
                </label>

                <button n:name="send" class="btn btn-primary mt-2">Přihlásit se</button>
            </form>
        </div>
    </div>

    <p class="mt-4 text-center text-sm">
        <a href="{plink :Home:}" class="link link-hover">← Vrátit se na web</a>
    </p>
</div>
