{varType Nette\Application\UI\Form $form}

{block title}Přihlášení{/block}

{block content}
<div class="mx-auto mt-8 w-full max-w-sm">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">Přihlášení</h1>

            <form n:name="signInForm" class="mt-2 flex flex-col gap-4">
                <div n:foreach="$form->getOwnErrors() as $error" class="alert alert-error text-sm">
                    {$error}
                </div>

                <fieldset class="fieldset w-full">
                    <label n:name="email" class="font-semibold">E-mail</label>
                    <input n:name="email" autofocus class="input w-full">
                    <p n:foreach="$form['email']->getErrors() as $error" class="text-sm text-error">{$error}</p>
                </fieldset>

                <fieldset class="fieldset w-full">
                    <label n:name="password" class="font-semibold">Heslo</label>
                    <input n:name="password" class="input w-full">
                    <p n:foreach="$form['password']->getErrors() as $error" class="text-sm text-error">{$error}</p>
                </fieldset>

                <button n:name="send" class="btn btn-primary mt-2">Přihlásit se</button>
            </form>
        </div>
    </div>

    <p class="mt-4 text-center text-sm">
        <a href="{plink :Home:}" class="link link-hover">← Vrátit se na web</a>
    </p>
</div>
