{varType Nette\Application\UI\Form $form}
{varType array $favoriteView}

{block title}Upravit oblíbený spis{/block}

{block breadcrumbs}
<li><a n:href="default">Přehled</a></li>
<li>Upravit oblíbený spis</li>
{/block}

{block content}
<div class="mx-auto mt-8 w-full max-w-md">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
            <h1 class="card-title">Spis {include case-chip from '../../@spisovka.latte', case: $favoriteView['case']}</h1>
            <p n:if="$favoriteView['case']['courtName'] !== null" class="text-sm text-base-content/60">{$favoriteView['case']['courtName']}</p>

            <form n:name="favoriteEditForm" class="mt-2 flex flex-col gap-4">
                <div n:foreach="$form->getOwnErrors() as $error" class="alert alert-error text-sm">
                    {$error}
                </div>

                <fieldset class="fieldset w-full">
                    <label n:name="name" class="font-semibold">Vlastní název <span class="font-normal text-base-content/60">(nepovinný)</span></label>
                    <input n:name="name" autofocus class="input w-full" placeholder="např. jméno klienta nebo věci">
                    <p n:foreach="$form['name']->getErrors() as $error" class="text-sm text-error">{$error}</p>
                </fieldset>

                <fieldset class="fieldset w-full">
                    <label n:name="group" class="font-semibold">Skupina</label>
                    <select n:name="group" class="select w-full"></select>
                </fieldset>

                <button n:name="send" class="btn btn-primary mt-2">Uložit</button>
            </form>
        </div>
    </div>

    <p class="mt-4 text-center text-sm">
        <a n:href="default" class="link link-hover">← Zpět na přehled</a>
    </p>
</div>
