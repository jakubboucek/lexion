{varType int $httpCode}
{varType ?string $message}

{block title}Chyba {$httpCode}{/block}

{block content}
<h1 class="text-2xl font-bold">Jejda…</h1>

<p class="mt-4">{$message ?? 'Požadavek se nepodařilo zpracovat.'}</p>

<p class="mt-2"><small>chyba {$httpCode}</small></p>

<div class="mt-6">
    <a href="{plink :Home:}" class="btn">← Zpět na úvod</a>
</div>
