{varType App\Presentation\Spis\CaseHeaderView $caseHeader}
{varType array[] $events}
{varType array[] $undatedEvents}
{varType array[] $related}
{varType ?string $infosoudUrl}

{block title}{if $caseHeader->favoriteName !== null}{$caseHeader->favoriteName} · {/if}{$caseHeader->spisovkaLabel} · {$caseHeader->court->name}{/block}

{block content}
<div class="max-w-3xl">
    {include case-header from './@case-header.latte'}

    <h2 class="mt-6 text-xl font-bold" n:if="$events !== []">Průběh řízení</h2>
    <div class="mt-2 overflow-x-auto" n:if="$events !== []">
        <table class="table table-zebra border border-base-300 bg-base-100">
            <thead>
                <tr><th>Datum</th><th>Událost</th></tr>
            </thead>
            <tbody>
                <tr n:foreach="$events as $event" n:class="$event['upcoming'] ? 'bg-warning/10! font-semibold'">
                    <td class="whitespace-nowrap">
                        {if $event['hasDetail']}
                            <span class="icon-[material-symbols-light--document-search-outline] align-[-0.125em] mr-1"
                                  role="img" aria-label="Detail události je načtený" title="Detail události je načtený"></span>
                        {else}
                            <span class="icon-[material-symbols-light--unknown-document-outline] align-[-0.125em] mr-1 text-base-content/60"
                                  role="img" aria-label="Detail události ještě není načtený" title="Detail události ještě není načtený"></span>
                        {/if}<a n:href="udalost, soud: $caseHeader->court->slug, znacka: $caseHeader->caseSlug, id: $event['id']"
                           class="link">{$event['date'] !== null ? ($event['date']|date:'j. n. Y') : '—'}</a>
                    </td>
                    <td>
                        <a n:href="udalost, soud: $caseHeader->court->slug, znacka: $caseHeader->caseSlug, id: $event['id']"
                           n:class="link, link-hover, $event['cancelled'] ? 'line-through text-base-content/50'">{$event['label']}</a>
                        <span n:if="$event['cancelled']" class="badge badge-ghost badge-sm ml-1">zrušeno</span>
                        {if $event['hearing'] !== null}
                            <div class="mt-0.5 text-sm text-base-content/60">
                                <span class="icon-[material-symbols-light--nest-clock-farsight-analog-outline] align-[-0.125em]" aria-hidden="true"></span>
                                {if $event['hearing']->startsAt !== null}{$event['hearing']->startsAt|date:'G:i'}{/if}{if $event['hearing']->room !== null} · {$event['hearing']->room}{/if}{if $event['hearing']->type !== null} · {$event['hearing']->type}{/if}
                            </div>
                        {elseif $event['hearingFetchable']}
                            <div class="mt-1">
                                <a n:href="fetchEvent! id: $event['id']" class="btn btn-xs font-normal">
                                    <span class="icon-[material-symbols-light--clock-arrow-down-rounded] text-[1.2em]" aria-hidden="true"></span>Stáhnout podrobnosti</a>
                            </div>
                        {/if}
                        {if $event['foreign'] !== null}
                            {var $f = $event['foreign']}
                            <div class="mt-0.5 text-sm text-base-content/60" title="Událost jiného spisu">
                                <span class="icon-[material-symbols-light--subdirectory-arrow-right] align-[-0.125em]" aria-hidden="true"></span>
                                {include case-chip from '../@spisovka.latte', case: $f, withCourt: true}
                            </div>
                        {/if}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {* Records upstream gives no date for (e.g. the NS procedural note): they
       have no place in the timeline, so they are listed separately. *}
    <h2 class="mt-6 text-xl font-bold" n:if="$undatedEvents !== []">Další události</h2>
    <div class="mt-2 overflow-x-auto" n:if="$undatedEvents !== []">
        <table class="table table-zebra border border-base-300 bg-base-100">
            <tbody>
                <tr n:foreach="$undatedEvents as $event">
                    <td>
                        {if $event['hasDetail']}
                            <span class="icon-[material-symbols-light--document-search-outline] align-[-0.125em] mr-1"
                                  role="img" aria-label="Detail události je načtený" title="Detail události je načtený"></span>
                        {else}
                            <span class="icon-[material-symbols-light--unknown-document-outline] align-[-0.125em] mr-1 text-base-content/60"
                                  role="img" aria-label="Detail události ještě není načtený" title="Detail události ještě není načtený"></span>
                        {/if}<a n:href="udalost, soud: $caseHeader->court->slug, znacka: $caseHeader->caseSlug, id: $event['id']"
                           n:class="link, link-hover, $event['cancelled'] ? 'line-through text-base-content/50'">{$event['label']}</a>
                        <span n:if="$event['cancelled']" class="badge badge-ghost badge-sm ml-1">zrušeno</span>
                        {if $event['foreign'] !== null}
                            {var $f = $event['foreign']}
                            <div class="mt-0.5 text-sm text-base-content/60" title="Událost jiného spisu">
                                <span class="icon-[material-symbols-light--subdirectory-arrow-right] align-[-0.125em]" aria-hidden="true"></span>
                                {include case-chip from '../@spisovka.latte', case: $f, withCourt: true}
                            </div>
                        {/if}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-6 text-xl font-bold" n:if="$related !== []">Související řízení</h2>
    <div class="mt-2 overflow-x-auto" n:if="$related !== []">
        <table class="table border border-base-300 bg-base-100">
            <thead>
                <tr><th>Spis</th><th>Vztah</th></tr>
            </thead>
            <tbody>
                <tr n:foreach="$related as $item">
                    <td>
                        {include bookmark from '../@bookmark.latte', state: $item['cached'] ? 'loaded' : 'none'}
                        {include case-chip from '../@spisovka.latte', case: $item}
                        <div class="mt-0.5 text-sm text-base-content/60">
                            {ifset $item['courtName']}{$item['courtName']}{else}
                                {* native title instead of the daisyUI tooltip: its bubble
                                   overflows the overflow-x-auto wrapper and forces a scrollbar *}
                                <span class="badge badge-ghost badge-sm cursor-help"
                                      title="Spisová značka zřejmě nenáleží žádnému ze soudů, může jít o jiný typ řízení, o kterém nejsou informace zveřejňované – např. obžaloba u státního zastupitelství">?</span>
                            {/ifset}
                        </div>
                    </td>
                    <td>
                        {implode(', ', $item['relations'])}
                        <div n:if="$item['subject'] !== null" class="mt-0.5 text-sm text-base-content/60">{$item['subject']}</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="mt-6 text-sm">
        <a href="{plink :Home:, znacka: $caseHeader->spisovkaLabel, soud: $caseHeader->court->kod}" class="link link-hover">← Zpět na vyhledávání</a>
    </p>
</div>
