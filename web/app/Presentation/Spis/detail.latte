{varType Nette\Database\Table\ActiveRow $court}
{varType string $spisovkaLabel}
{varType string $caseSlug}
{varType Nette\Database\Table\ActiveRow $proceeding}
{varType ?array $infosoud}
{varType ?array $isir}
{varType ?string $subject}
{varType string[] $nsAttributes}
{varType array[] $events}
{varType array[] $related}
{varType ?string $infosoudUrl}
{varType bool $isStale}

{block title}{$spisovkaLabel} · {$court->name}{/block}

{block content}
<div class="max-w-3xl">
    <h1 class="text-2xl font-bold">Spis {include spisovka from '../@spisovka.latte', label: $spisovkaLabel}</h1>
    <p class="mt-1 text-base-content/70">
        {$court->name}{if $infosoud !== null && ($infosoud['nadrizenaOrganizace'] ?? null)} · nadřízený: {$infosoud['nadrizenaOrganizace']}{/if}
    </p>

    <div n:if="$isStale" class="alert alert-warning mt-4">
        <span>
            Vidíte starší verzi spisu ({$proceeding->infosoud_at|date:'j. n. Y H:i'}) — systém ji
            průběžně neudržuje.
            <a n:href="refresh!" class="link font-semibold">Aktualizovat nyní</a>
        </span>
    </div>

    <div class="card mt-4 border border-base-content/25 bg-base-100 shadow-sm">
        <div class="card-body gap-2">
            <div n:if="$subject !== null">
                <span class="font-semibold">Předmět řízení:</span> {$subject}
            </div>
            <div n:if="$infosoud !== null && ($infosoud['stav'] ?? null)">
                <span class="font-semibold">Stav řízení:</span> {$infosoud['stav']}
                {if $infosoud['stavDatum'] ?? null}(od {$infosoud['stavDatum']}){/if}
            </div>

            {if $nsAttributes !== []}
                <div n:if="$nsAttributes['SLOZENI_SENATU'] ?? null">
                    <span class="font-semibold">Složení senátu:</span>
                    {implode(', ', explode('|', $nsAttributes['SLOZENI_SENATU']))}
                </div>
                <div n:if="$nsAttributes['ODVOL_SOUD'] ?? null">
                    <span class="font-semibold">Odvolací soud:</span> {$nsAttributes['ODVOL_SOUD']}
                    {if $nsAttributes['PR_VEC_NS'] ?? null}· napadené rozhodnutí {$nsAttributes['PR_VEC_NS']}{/if}
                </div>
            {/if}

            <div n:if="$isir !== null" class="border-t border-base-300 pt-2">
                <span class="font-semibold">Insolvenční rejstřík:</span>
                {foreach $isir['debtors'] ?? [] as $debtor}
                    {$debtor['name'] ?? '?'}{if $debtor['ic'] ?? null} (IČ {$debtor['ic']}){/if}{sep}, {/sep}
                {/foreach}
                {if $isir['startedAt'] ?? null}· zahájeno {$isir['startedAt']}{/if}
            </div>

            <div n:if="$infosoudUrl !== null" class="card-actions mt-2">
                <a href="{$infosoudUrl}" target="_blank" rel="noopener" class="btn font-normal">
                    <span class="icon-[material-symbols-light--arrow-right-alt] text-[1.2em]" aria-hidden="true"></span>InfoSoud</a>
            </div>
        </div>
    </div>
    <p n:if="$proceeding->infosoud_at !== null" class="mt-1.5 text-xs text-base-content/40">
        Data z infoSoudu: {$proceeding->infosoud_at|date:'j. n. Y H:i'}
        · <a n:href="refresh!" class="link">aktualizovat</a>
    </p>

    <h2 class="mt-6 text-xl font-bold" n:if="$events !== []">Průběh řízení</h2>
    <div class="mt-2 overflow-x-auto" n:if="$events !== []">
        <table class="table table-zebra border border-base-300 bg-base-100">
            <thead>
                <tr><th>Datum</th><th>Událost</th></tr>
            </thead>
            <tbody>
                <tr n:foreach="$events as $event">
                    <td class="whitespace-nowrap">
                        {if $event['hasDetail']}
                            <span class="icon-[material-symbols-light--document-search-outline] align-[-0.125em] mr-1"
                                  role="img" aria-label="Detail události je načtený" title="Detail události je načtený"></span>
                        {else}
                            <span class="icon-[material-symbols-light--unknown-document-outline] align-[-0.125em] mr-1 text-base-content/60"
                                  role="img" aria-label="Detail události ještě není načtený" title="Detail události ještě není načtený"></span>
                        {/if}<a n:href="udalost, soud: $court->slug, znacka: $caseSlug, id: $event['id']"
                           class="link">{$event['date'] !== null ? ($event['date']|date:'j. n. Y') : '—'}</a>
                    </td>
                    <td>
                        <a n:href="udalost, soud: $court->slug, znacka: $caseSlug, id: $event['id']"
                           n:class="link, link-hover, $event['cancelled'] ? 'line-through text-base-content/50'">{$event['label']}</a>
                        <span n:if="$event['cancelled']" class="badge badge-ghost badge-sm ml-1">zrušeno</span>
                        {if $event['foreign'] !== null}
                            {var $f = $event['foreign']}
                            <div class="mt-0.5 text-sm text-base-content/60" title="Událost jiného spisu">
                                <span class="icon-[material-symbols-light--subdirectory-arrow-right] align-[-0.125em]" aria-hidden="true"></span>
                                {include spisovka from '../@spisovka.latte', label: $f['label'],
                                    href: $f['linkable'] ? $presenter->link('detail', ['soud' => $f['courtSlug'], 'znacka' => $f['slug']])}{if $f['courtName']} · {$f['courtName']}{/if}
                            </div>
                        {/if}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <h2 class="mt-6 text-xl font-bold" n:if="$related !== []">Související řízení</h2>
    <p class="mt-1 text-sm text-base-content/60" n:if="$related !== []">
        Související spisy se načítají až po otevření — kliknutím na odkaz.
    </p>
    <div class="mt-2 overflow-x-auto" n:if="$related !== []">
        <table class="table border border-base-300 bg-base-100">
            <thead>
                <tr><th>Spis</th><th>Soud</th><th>Vztah</th></tr>
            </thead>
            <tbody>
                <tr n:foreach="$related as $item">
                    <td>
                        {include bookmark from '../@bookmark.latte', state: $item['cached'] ? 'loaded' : 'none'}
                        {include spisovka from '../@spisovka.latte', label: $item['label'],
                            href: $item['linkable'] ? $presenter->link('detail', ['soud' => $item['courtSlug'], 'znacka' => $item['slug']])}
                    </td>
                    <td>{$item['courtName'] ?? '?'}</td>
                    <td>{implode(', ', $item['relations'])}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="mt-6 text-sm">
        <a href="{plink :Home:}" class="link link-hover">← Zpět na vyhledávání</a>
    </p>
</div>
