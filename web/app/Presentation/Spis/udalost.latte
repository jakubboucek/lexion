{varType App\Presentation\Spis\CaseHeaderView $caseHeader}
{varType App\Presentation\Spis\EventView $event}

{block title}{$event->label} · {$caseHeader->spisovkaLabel} · {$caseHeader->court->name}{/block}

{block content}
<div class="max-w-3xl">
    {include case-header from './@case-header.latte', backToCase: true}

    <h2 class="mt-6 text-xl font-bold">Událost: {$event->label}</h2>
    <p class="mt-1 text-base-content/70">
        {if $event->date !== null}{$event->date|date:'j. n. Y'}
        {else}<em>(datum události není známo)</em>{/if}
        <span n:if="$event->cancelled" class="badge badge-warning align-middle"><span
            class="icon-[material-symbols-light--warning] align-[-0.125em]" aria-hidden="true"></span>zrušeno</span>
    </p>

    {define navazne-table}
        <h3 class="mt-6 text-lg font-bold">Navazující spisy</h3>
        <div class="mt-2 overflow-x-auto">
            <table class="table border border-base-300 bg-base-100">
                <thead>
                    <tr><th>Spis</th><th>Soud</th><th>Vztah</th></tr>
                </thead>
                <tbody>
                    <tr n:foreach="$event->navazneVeci as $item">
                        <td>
                            {include bookmark from '../@bookmark.latte', state: $item['cached'] ? 'loaded' : 'none'}
                            {include case-chip from '../@spisovka.latte', case: $item}
                        </td>
                        <td>{$item['courtName'] ?? '?'}</td>
                        <td>{$item['typeLabel']}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    {/define}

    {if $event->navazneFirst && $event->navazneVeci !== []}{include navazne-table}{/if}

    <div class="card mt-4 border border-base-content/25 bg-base-100 shadow-sm">
        <div class="card-body gap-2">
            <h3 n:if="$event->description !== null" class="card-title text-base">{$event->description}</h3>

            {* Fetched but empty covers both shapes upstream uses for "nothing to
               show": no detail at all, and a detail carrying no attributes. *}
            {if $event->attributes === [] && $event->fetchedAt !== null}
                <p class="text-base-content/60">
                    <span class="icon-[material-symbols-light--warning-outline] align-[-0.125em]" aria-hidden="true"></span>
                    infoSoud k události neposkytuje žádné podrobnosti.
                </p>
            {elseif $event->attributes === [] && !$event->fetchable}
                {* Record without an upstream address (no poradi / unknown owner
                   court) - the detail cannot ever be fetched, say so honestly. *}
                <p class="text-base-content/60">
                    <span class="icon-[material-symbols-light--warning-outline] align-[-0.125em]" aria-hidden="true"></span>
                    K tomuto záznamu nelze podrobnosti z infoSoudu dohledat.
                </p>
            {elseif $event->attributes === []}
                <p class="text-base-content/60">Podrobnosti se nepodařilo načíst — zkuste to prosím později.</p>
            {else}
                <div n:foreach="$event->attributes as $attribute" class="flex flex-col sm:flex-row sm:gap-2">
                    <span class="font-semibold sm:min-w-64">{$attribute['label']}{if $attribute['value'] !== null}:{/if}</span>
                    {* A quoted file number renders as the usual chip; a reference we
                       cannot resolve to a court case stays plain text (see presenter). *}
                    {if ($attribute['cases'] ?? null) !== null}
                        <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            {foreach $attribute['cases'] as $case}
                                {if !isset($case['label'])}
                                    <span>{$case['text']}</span>
                                {else}
                                    <span>
                                        {include case-chip from '../@spisovka.latte', case: $case, withCourt: true}
                                    </span>
                                {/if}
                            {/foreach}
                        </span>
                    {else}
                        <span n:if="$attribute['value'] !== null">{$attribute['value']}</span>
                    {/if}
                </div>
            {/if}

            <div class="card-actions mt-2">
                {if $event->infosoudUrl !== null}
                    <a href="{$event->infosoudUrl}" target="_blank" rel="noopener" class="btn font-normal">
                        <span class="icon-[material-symbols-light--arrow-right-alt] text-[1.2em]" aria-hidden="true"></span>InfoSoud</a>
                {/if}
            </div>

            <div n:if="$event->owner !== null" class="mt-4 text-sm text-base-content/70">
                <hr class="mb-3 border-base-content/20">
                <span>
                    Událost patří do spisu
                    {include case-chip from '../@spisovka.latte', case: $event->owner}
                    {if $event->owner['courtName'] !== null} ({$event->owner['courtName']}){/if}
                    — u tohoto spisu se zobrazuje jako související událost.
                </span>
            </div>

        </div>
    </div>
    <p n:if="$event->fetchable" class="mt-1.5 text-xs text-base-content/40 transition-colors hover:text-base-content/70">
        {if $event->fetchedAt !== null}Detail z infoSoudu: {$event->fetchedAt|date:'j. n. Y H:i'} ·{/if}
        <a n:href="refreshEvent!" class="link">aktualizovat</a>
    </p>

    {if !$event->navazneFirst && $event->navazneVeci !== []}{include navazne-table}{/if}
</div>
