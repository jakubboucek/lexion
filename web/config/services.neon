services:
  - App\Core\Authenticator
  router: App\Core\RouterFactory::createRouter()

  # Entity hydration (see docs/architektura.md). NetteDatabase format:
  # values are already typed on both sides, so instances pass through. Every
  # hydrated date-time is normalized into the application time zone.
  - JakubBoucek\Hydrator\HydratorFactory(
      format: 'JakubBoucek\Hydrator\Format\NetteDatabase'
      timeZone: DateTimeZone('Europe/Prague')
    )

  # Codelist snapshot cache (see docs/analyza-ciselniky.md): in debug mode the
  # cache auto-refreshes on entity/set class changes (a la the DI container),
  # in production it is valid until the deploy purges temp/cache.
  - App\Model\Codelist\CodelistCache(debugMode: %debugMode%)

  # Application log (docs/logovani.md): run files live in the same
  # directory as the Tracy log (web/log, deploy-ignored).
  - App\Model\Log\LogService(logDir: %appDir%/../log)

  # Explicitly registered services whose class-name suffix is not in the
  # auto-registration list below (a Parser/Resolver/Builder is not a service
  # by nature - such classes may just as well be products of a factory, so
  # their suffixes must never auto-register; decision 2026-08-23).
  - App\Model\Codelist\CourtCodeResolver
  - App\Model\Infosoud\InfosoudLinkBuilder
  - App\Model\Infosoud\InfosoudOwnershipResolver
  - App\Model\Spisovka\SpisovkaParser
  - App\Model\Spisovka\SpisovkaResolver
  - App\Model\Spisovka\SpisovkaSlugParser


# Auto-registration of services, restricted to suffixes that ALWAYS denote a
# service in this project (a class matching them never comes out of a
# factory). Anything else is registered explicitly above. Presentation/ is
# excluded: presenters and controls are created by Nette itself, and
# RouterFactory is a static class - only the *Factory pattern would otherwise
# pull it in as a service.
search:
  - in: %appDir%
    exclude:
      classes:
        - App\Core\RouterFactory
    classes:
      - *Facade
      - *Factory
      - *Repository
      - *Service
      - *Client
      - *Provider
