services:
  - App\Core\Authenticator
  router: App\Core\RouterFactory::createRouter()

  # Entity hydration (see docs/entity-refactoring.md). NetteDatabase format:
  # values are already typed on both sides, so instances pass through. Every
  # hydrated date-time is normalized into the application time zone.
  - JakubBoucek\Hydrator\HydratorFactory(
      format: 'JakubBoucek\Hydrator\Format\NetteDatabase'
      timeZone: DateTimeZone('Europe/Prague')
    )

  # Codelist snapshot cache (see docs/analyza-ciselniky.md): in debug mode the
  # cache auto-refreshes on entity/set class changes (a la the DI container),
  # in production it is valid until the deploy purges temp/cache.
  - App\Model\Codelist\CodelistCache(debugMode: %debugMode%)


search:
  - in: %appDir%
    classes:
      - *Facade
      - *Factory
      - *Repository
      - *Service
      - *Client
      - *Parser
      - *Resolver
      - *Builder
