parameters:
  level: 8
  paths:
    - app
    # CLI tools and data migrations live outside web/ but share the app code;
    # they carry the riskiest hand-written SQL, so they get analysed too.
    - ../bin
    - ../migrations/data
  ignoreErrors:
    # The CLI SAPI always populates $argv; PHPStan cannot know these scripts
    # never run under a web SAPI.
    - message: '#Variable \$argv might not be defined#'
      paths:
        - ../bin/*
        - ../migrations/data/*
    # Thin repositories intentionally pass untyped arrays and bare Selections.
    - identifier: missingType.generics
    - identifier: missingType.iterableValue
    - identifier: missingType.callable
